---
import Layout from "../../layouts/Layout.astro";
import { getAllPosts, getPost } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = getAllPosts();

  return posts.map((post) => ({
    params: { slug: post.slug },
  }));
}

const post = await getPost(Astro.params.slug!);
---

<style>
  .post-wrapper {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 1rem;
  }

  .post-card {
    background: white;
    padding: 2.5rem;
    border-radius: 12px;
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.08);
  }

  .post-card h1 {
    margin: 0 0 0.75rem;
    font-size: clamp(2rem, 3vw, 2.8rem);
    color: #1a3a1a;
  }

  .post-meta {
    margin: 0 0 2rem;
    color: #5f6d5f;
    font-size: 0.95rem;
  }

  .post-meta span {
    display: inline-block;
    margin-right: 1rem;
  }

  .post-content {
    color: #344334;
    line-height: 1.85;
  }

  .post-content h2,
  .post-content h3 {
    color: #1a3a1a;
    margin-top: 2rem;
  }

  .post-content p {
    margin: 1rem 0;
  }

  .post-content img {
    max-width: 100%;
    border-radius: 8px;
  }

  @media (max-width: 640px) {
    .post-wrapper {
      padding: 2rem 1rem;
    }
  }
</style>

<Layout>
  {
    !!post ? (
      <section class="post-wrapper">
        <article class="post-card">
          <h1>{post.title}</h1>
          <p class="post-meta">
            <span>
              {new Date(post.date).toLocaleDateString("en-US", {
                day: "2-digit",
                month: "2-digit",
                year: "numeric",
              })}
            </span>
            <span>/{post.slug}</span>
          </p>
          <div class="post-content" set:html={post.contentHtml} />
        </article>
      </section>
    ) : (
      <p>Not found 404</p>
    )
  }
</Layout>
